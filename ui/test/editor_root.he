use web
use core
use md
use editor
var NAME byte[>..]
var ARG byte[>..]
var LINE byte[>..]
run():
	while core::take(NAME, ARG):
		if starts_with(NAME, "editor."):
			editor::act(NAME[7..], ARG)
		else:
			LINE.clear()
			LINE.append("<div>")
			md::esc_html(LINE, NAME)
			LINE.append("|")
			md::esc_html(LINE, ARG)
			LINE.append("</div>")
			web::append_html(web::el("posted"), LINE);
main():
	core::init()
	editor::init()
	web::listen(web::BODY, "click", 1, 0)
	run();
export he_event(tag i32, kind i32):
	if tag == 1:
		h i32 := web::closest(web::ev_target(), "[data-act]")
		if h != 0:
			a byte[>..] ~= []
			g byte[>..] ~= []
			web::get_attr(h, "data-act", a)
			web::get_attr(h, "data-arg", g)
			core::post_el(a, g, h)
	else if tag < 100:
		core::event(tag, kind)
	else if tag >= 400 && tag < 500:
		editor::event(tag, kind)
	run();
