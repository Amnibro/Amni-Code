import os;
import gfx;
import math;
import json;
import gfx.codec_png;
import gfx.sdf_font;
let ENVP = "PATH=\"$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.agy/bin:$HOME/.grok/bin:$PATH\"; ";
let RAD f32 = 0.017453292;
let SPIN real = 0.7;
fn pname(p int) const byte[:] {
	match p {
		0 => "Grok Bot",
		1 => "Claude Code",
		2 => "Antigravity",
		_ => "OpenCode",
	}
}
fn pkey(p int) const byte[:] {
	match p {
		0 => "grok",
		1 => "claude",
		2 => "antigravity",
		_ => "opencode",
	}
}
fn pexe(p int) const byte[:] {
	match p {
		0 => "grok",
		1 => "claude",
		2 => "agy",
		_ => "opencode",
	}
}
struct Session { p int, n int, dir byte[..1024], sid byte[..160], cwd byte[..1024], model byte[..128], mode byte[..64], act byte[..160], first int, count int, size int, shown int, busy bool, since real, demo bool, ctx real, cost real, out_tok real, turns int }
struct HoleU { a float4, h0 float4, h1 float4, m float4 }
struct PostU { a float4, b float4 }
var S Session[>..];
var POOL byte[>..];
var LOFF int[>..];
var LLEN int[>..];
var AV bool[4] = [false; 4];
var LASTP int[4] = [-1; 4];
var ROOT byte[>..];
var HOME byte[>..];
var CUR int = 0;
var ROT f32 = 0.0;
var ROT0 f32 = 0.0;
var ROT1 f32 = 0.0;
var T0 real = -9.0;
var NOW real = 0.0;
var SCROLL f32 = 0.0;
var VIEW int = 0;
var VIEWT f32 = 0.0;
var VIEWF f32 = 0.0;
var HIDE int = 0;
var INPUT byte[>..];
var DARK bool = true;
var FRAMES bool = false;
var W int = 1400;
var H int = 900;
var CX f32 = 700.0;
var CY f32 = 450.0;
var R f32 = 400.0;
var WRAPU f32 = 40.0;
var YS f32 = 1.0;
var BX f32 = 0.0;
var BY f32 = 0.0;
var WG f32 = 0.0;
var S0 f32 = 27.0;
var FR int = 0;
var FY0 f32 = 0.0;
var FY1 f32 = 1.0;
var FC f32 = 0.5;
var LOGO TextVtx[>..];
var READY bool = false;
var PB gfx::Pipeline;
var PO gfx::Pipeline;
var PD gfx::Pipeline;
var PU gfx::Pipeline;
var SM gfx::Sampler;
var SC gfx::Texture;
var BL gfx::Texture[4] = [gfx::Texture { 0 }; 4];
var TW int = 0;
var TH int = 0;
var HX float4[2] = [float4 { 0.0, 0.0, 0.0, 0.0 }; 2];
var NH int = 0;
fn wf() f32 { W as f32 }
fn hf() f32 { H as f32 }
fn set_text<T>(dst T&, src const byte[:]) {
	dst.clear();
	dst.append(src[..min(src.len, dst.cap)]);
}
fn channel(x f32) byte {
	let v = clamp(x * 255.0, 0.0, 255.0) as int;
	v as byte
}
fn rgba(c float3, a f32) byte[4] {
	return [channel(c.x), channel(c.y), channel(c.z), channel(a)];
}
fn rgb(r f32, g f32, b f32) float3 { float3 { r, g, b } }
fn pick(d float3, l float3) float3 { if DARK { d } else { l } }
fn theme3(k int) float3 {
	match k {
		0 => pick(rgb(0.012, 0.018, 0.04), rgb(0.958, 0.938, 0.882)),
		1 => pick(rgb(0.90, 0.88, 0.82), rgb(0.20, 0.16, 0.09)),
		2 => pick(rgb(1.0, 0.80, 0.42), rgb(0.70, 0.50, 0.12)),
		3 => pick(rgb(0.55, 0.58, 0.68), rgb(0.48, 0.42, 0.32)),
		4 => pick(rgb(0.03, 0.045, 0.09), rgb(0.995, 0.98, 0.94)),
		_ => pick(rgb(0.0, 0.0, 0.0), rgb(0.80, 0.68, 0.42)),
	}
}
fn tc(k int, a f32) byte[4] { return rgba(theme3(k), a); }
fn accent3(k int) float3 {
	match k {
		0 => pick(rgb(0.55, 0.90, 0.95), rgb(0.10, 0.42, 0.50)),
		1 => pick(rgb(0.47, 0.80, 0.98), rgb(0.17, 0.38, 0.62)),
		2 => pick(rgb(1.0, 0.40, 0.33), rgb(0.75, 0.17, 0.12)),
		3 => pick(rgb(0.40, 0.95, 0.55), rgb(0.15, 0.55, 0.25)),
		4 => pick(rgb(1.0, 0.72, 0.25), rgb(0.78, 0.47, 0.05)),
		_ => pick(rgb(0.72, 0.55, 1.0), rgb(0.45, 0.30, 0.75)),
	}
}
fn ac(k int, a f32) byte[4] { return rgba(accent3(k), a); }
fn plat3(p int) float3 {
	match p {
		0 => rgb(0.55, 0.57, 0.65),
		1 => rgb(0.85, 0.50, 0.32),
		2 => rgb(0.32, 0.55, 0.95),
		_ => rgb(0.40, 0.75, 0.45),
	}
}
fn shadow(a f32) byte[4] {
	let k f32 = if DARK { 0.45 } else { 0.12 };
	return rgba(theme3(5), a * k);
}
fn mix3(a float3, b float3, t f32) float3 { float3 { a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t } }
fn session_dir(p int, n int) byte[>..] { str(ROOT, "/", pkey(p), "/", n) }
fn add_session(p int, n int) int {
	var s = Session { p: p, n: n, size: -1, since: -1.0, .. };
	let d = session_dir(p, n);
	set_text(s.dir, d);
	s.demo = file_exists(str(d, "/demo"));
	S.push(s);
	S.len - 1
}
fn make_session(p int) int {
	var n = 1;
	while is_dir(session_dir(p, n)) { n += 1; }
	let d = session_dir(p, n);
	run_command(str("mkdir -p '", d, "'"));
	add_session(p, n)
}
fn scan() {
	for p in 4 {
		var n = 1;
		while is_dir(session_dir(p, n)) {
			add_session(p, n);
			n += 1;
		}
		if n == 1 { make_session(p); }
		LASTP[p] = -1;
		for i in S.len {
			if S[i].p == p {
				LASTP[p] = i;
				break;
			}
		}
	}
}
fn check_available() {
	for p in 4 {
		let cmd = str(ENVP, "command -v ", pexe(p), " >/dev/null 2>&1");
		AV[p] = run_command(cmd) == 0;
	}
}
fn tilde(path const byte[:]) byte[>..] {
	var out byte[>..] = [];
	if starts_with(path, HOME[..]) {
		out.push('~');
		out.append(path[HOME.len..]);
	} else {
		out.append(path);
	}
	out
}
fn rank(i int) int {
	var r = 0;
	for j in i {
		if S[j].p == S[i].p { r += 1; }
	}
	r
}
fn nth(p int, r int) int {
	var seen = 0;
	for i in S.len {
		if S[i].p == p {
			if seen == r { return i; }
			seen += 1;
		}
	}
	-1
}
fn cnt(p int) int {
	var n = 0;
	for i in S.len {
		if S[i].p == p { n += 1; }
	}
	n
}
fn span() f32 { 360.0 / (S.len as f32) }
fn order(i int) int {
	var n = rank(i);
	for j in S.len {
		if S[j].p < S[i].p { n += 1; }
	}
	n
}
fn center(i int) f32 { ((order(i) as f32) + 0.5) * span() }
fn ang(t f32) f32 { (t + ROT + 90.0) * RAD }
fn wrap_deg(a f32) f32 {
	var d = a;
	while d > 180.0 { d -= 360.0; }
	while d < -180.0 { d += 360.0; }
	d
}
fn visible(i int) int {
	if i == CUR { max(0, S[i].count - HIDE) } else { S[i].count }
}
fn go_to(i int) {
	let d = wrap_deg(-center(i) - ROT1);
	ROT0 = ROT;
	ROT1 = ROT1 + d;
	T0 = NOW;
	CUR = i;
	LASTP[S[i].p] = i;
	VIEW = 0;
	VIEWT = 0.0;
	VIEWF = 0.0;
	S[i].shown = visible(i);
}
fn step_by(dir int) {
	let p = S[CUR].p;
	let m = cnt(p);
	go_to(nth(p, (rank(CUR) + dir + m) % m));
}
fn visible_w(t const byte[:], size f32) f32 {
	var w f32 = 0.0;
	var st = 0;
	for i in t.len + 1 {
		var stop = i == t.len;
		if !stop {
			let b = t[i];
			stop = (b >= 1 && b <= 6) || b == 9;
		}
		if stop {
			if i > st { w += sdf_text_w(t[st..i], size); }
			st = i + 1;
		}
	}
	w
}
fn utf_len(b byte) int {
	if b >= 240 { 4 } else if b >= 224 { 3 } else if b >= 192 { 2 } else { 1 }
}
fn digit_byte(b byte) bool { b >= '0' && b <= '9' }
fn put_line(out byte[>..]&, t const byte[:]) {
	out.append(t);
	out.push('\n');
}
fn hang_indent(t const byte[:]) int {
	var n = 0;
	while n < t.len && t[n] == ' ' { n += 1; }
	let rest = t[n..t.len];
	if starts_with(rest, "• ") || starts_with(rest, "◦ ") || starts_with(rest, "▪ ") || starts_with(rest, "☐ ") || starts_with(rest, "☑ ") { return n + 2; }
	if rest.len > 0 && rest[0] == 2 {
		var d = 1;
		while d < rest.len && digit_byte(rest[d]) { d += 1; }
		if d > 1 && d + 1 < rest.len && rest[d] == '.' && rest[d + 1] == 2 { return n + d - 1 + 2; }
	}
	n
}
fn wrap(out byte[>..]&, k byte, t const byte[:]) {
	let h = if k == 'p' { hang_indent(t) } else { 0 };
	let table = k == 'b' || k == 'H';
	let clipped = table || k == 't';
	var cur byte[>..] = [];
	cur.push(k);
	var width f32 = 0.0;
	var i = 0;
	var full = false;
	while i < t.len && !full {
		let b = t[i];
		let from = i;
		let end = min(i + utf_len(b), t.len);
		i = end;
		if b == 13 || b >= 240 || (b >= 128 && b < 192) { continue; }
		if (b >= 1 && b <= 8) || (b == 9 && table) {
			cur.push(b);
			continue;
		}
		var ch byte[..4] = [];
		if b == 9 { ch.push(' '); } else { ch.append(t[from..end]); }
		let times = if b == 9 { 2 } else { 1 };
		for rep in times {
			if full { continue; }
			cur.append(ch[..]);
			width += sdf_text_w(ch[..], 1.0);
			if width > WRAPU {
				if clipped {
					cur.append("…");
					full = true;
				} else {
					var cut = cur.len;
					var j = cur.len - 1;
					while j > h + 1 && cur[j] != ' ' { j -= 1; }
					if j > h + 1 && j > cur.len / 3 { cut = j; }
					put_line(out, cur[..cut]);
					var carried byte[>..] = [];
					carried.push(k);
					for z in h { carried.push(' '); }
					for m in 1..9 {
						var odd = false;
						for q in cur[..cut] {
							if (q as int) == m { odd = !odd; }
						}
						if odd { carried.push(m as byte); }
					}
					if cut + 1 < cur.len { carried.append(cur[cut + 1..cur.len]); }
					cur.clear();
					cur.append(carried);
					width = visible_w(cur[1..cur.len], 1.0);
				}
			}
		}
	}
	if cur.len > 1 { put_line(out, cur[..]); }
}
struct TexSym { name byte[..16], sym byte[..8] }
var TEXSYMS TexSym[>..];
fn letter_byte(b byte) bool { (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') }
fn char_count(t const byte[:]) int {
	var n = 0;
	for b in t {
		if b < 128 || b >= 192 { n += 1; }
	}
	n
}
fn script_char(out byte[>..]&, ch const byte[:], sup bool) bool {
	let from = if sup { "0123456789+−=()abcdefghijklmnoprstuvwxyzT′" } else { "0123456789+−=()aehijklmnoprstuvx" };
	let to = if sup { "⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ᵃᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖʳˢᵗᵘᵛʷˣʸᶻᵀ′" } else { "₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎ₐₑₕᵢⱼₖₗₘₙₒₚᵣₛₜᵤᵥₓ" };
	var at = -1;
	var i = 0;
	var pos = 0;
	while i < from.len {
		let e = min(i + utf_len(from[i]), from.len);
		if from[i..e] == ch {
			at = pos;
			break;
		}
		i = e;
		pos += 1;
	}
	if at < 0 { return false; }
	var j = 0;
	var seen = 0;
	while j < to.len {
		let e = min(j + utf_len(to[j]), to.len);
		if seen == at {
			out.append(to[j..e]);
			return true;
		}
		j = e;
		seen += 1;
	}
	false
}
fn tex_group(s const byte[:], j int) int, int, int {
	var a = j;
	while a < s.len && s[a] == ' ' { a += 1; }
	if a >= s.len { return s.len, s.len, s.len; }
	if s[a] == '{' {
		var depth = 0;
		var k = a;
		while k < s.len {
			if s[k] == '{' {
				depth += 1;
			} else if s[k] == '}' {
				depth -= 1;
				if depth == 0 { return a + 1, k, k + 1; }
			}
			k += 1;
		}
		return a + 1, s.len, s.len;
	}
	let e = min(a + utf_len(s[a]), s.len);
	return a, e, e;
}
fn tex_paren(out byte[>..]&, part const byte[:], parens bool) {
	if parens { out.push('('); }
	out.append(part);
	if parens { out.push(')'); }
}
fn tex_frac(out byte[>..]&, mark int, mid int) {
	var a byte[>..] = [];
	a.append(out[mark..mid]);
	var b byte[>..] = [];
	b.append(out[mid..out.len]);
	out.resize(mark, 0);
	let na = char_count(a);
	let nb = char_count(b);
	if na == 1 && nb == 1 {
		out.append(a);
		out.append("⁄");
		out.append(b);
	} else {
		tex_paren(out, a, na > 1);
		out.push('/');
		tex_paren(out, b, nb > 1);
	}
}
fn tex_sqrt(out byte[>..]&, mark int) {
	var g byte[>..] = [];
	g.append(out[mark..out.len]);
	out.resize(mark, 0);
	out.append("√");
	tex_paren(out, g, char_count(g) != 1);
}
fn tex_script(out byte[>..]&, mark int, sup bool) {
	var f byte[>..] = [];
	f.append(out[mark..out.len]);
	out.resize(mark, 0);
	var conv byte[>..] = [];
	var every = true;
	var i = 0;
	while i < f.len {
		let e = min(i + utf_len(f[i]), f.len);
		if !script_char(conv, f[i..e], sup) { every = false; }
		i = e;
	}
	if every {
		out.append(conv);
	} else {
		if sup { out.push(7); } else { out.push(8); }
		out.append(f);
		if sup { out.push(7); } else { out.push(8); }
	}
}
fn tex_bb(out byte[>..]&, g const byte[:]) {
	if g == "R" {
		out.append("ℝ");
	} else if g == "N" {
		out.append("ℕ");
	} else if g == "Z" {
		out.append("ℤ");
	} else if g == "Q" {
		out.append("ℚ");
	} else if g == "C" {
		out.append("ℂ");
	} else {
		out.append(g);
	}
}
fn tex_styled(name const byte[:]) bool {
	name == "mathrm" || name == "mathbf" || name == "mathit" || name == "mathsf" || name == "mathtt" || name == "boldsymbol" || name == "operatorname"
}
fn tex_named(out byte[>..]&, name const byte[:]) {
	if name == "left" || name == "right" || name == "displaystyle" || name == "limits" || name == "nonumber" || name == "big" || name == "Big" || name == "bigg" || name == "Bigg" { return; }
	if name == "quad" {
		out.append("  ");
		return;
	}
	if name == "qquad" {
		out.append("    ");
		return;
	}
	if TEXSYMS.len == 0 {
		let table = texsyms();
		TEXSYMS.append(table);
	}
	for entry in TEXSYMS {
		if entry.name[..] == name {
			out.append(entry.sym[..]);
			return;
		}
	}
	out.append(name);
}
recursive fn tex_into(out byte[>..]&, s const byte[:]) {
	var i = 0;
	while i < s.len {
		let c = s[i];
		if c == '\\' && i + 1 < s.len {
			var e = i + 1;
			while e < s.len && letter_byte(s[e]) { e += 1; }
			if e > i + 1 {
				let name = s[i + 1..e];
				i = e;
				if name == "frac" {
					let a0, a1, an = tex_group(s, i);
					let b0, b1, bn = tex_group(s, an);
					let mark = out.len;
					tex_into(out, s[a0..a1]);
					let mid = out.len;
					tex_into(out, s[b0..b1]);
					tex_frac(out, mark, mid);
					i = bn;
				} else if name == "sqrt" {
					let g0, g1, gn = tex_group(s, i);
					let mark = out.len;
					tex_into(out, s[g0..g1]);
					tex_sqrt(out, mark);
					i = gn;
				} else if name == "mathbb" {
					let g0, g1, gn = tex_group(s, i);
					tex_bb(out, s[g0..g1]);
					i = gn;
				} else if name == "text" {
					let g0, g1, gn = tex_group(s, i);
					out.append(s[g0..g1]);
					i = gn;
				} else if tex_styled(name) {
					let g0, g1, gn = tex_group(s, i);
					tex_into(out, s[g0..g1]);
					i = gn;
				} else {
					tex_named(out, name);
				}
			} else {
				let d = s[i + 1];
				if d == '\\' || d == ',' || d == ';' || d == ':' || d == ' ' {
					let spaced = (out.len > 0 && out[out.len - 1] == ' ') || (i + 2 < s.len && s[i + 2] == ' ');
					if !spaced { out.push(' '); }
				} else if d != '!' {
					out.push(d);
				}
				i += 2;
			}
		} else if c == '^' || c == '_' {
			let g0, g1, gn = tex_group(s, i + 1);
			let mark = out.len;
			tex_into(out, s[g0..g1]);
			tex_script(out, mark, c == '^');
			i = gn;
		} else {
			if c == '~' {
				out.push(' ');
			} else if c == '-' {
				out.append("−");
			} else if c == '\'' {
				out.append("′");
			} else if c != '{' && c != '}' && !(c == ' ' && out.len > 0 && out[out.len - 1] == ' ') {
				out.push(c);
			}
			i += 1;
		}
	}
}
fn tex(s const byte[:]) byte[>..] {
	var out byte[>..] = [];
	tex_into(out, s);
	out
}
fn texsyms() TexSym[>..] {
	var r TexSym[>..] = [];
	r.push(TexSym{"alpha", "α"});
	r.push(TexSym{"beta", "β"});
	r.push(TexSym{"gamma", "γ"});
	r.push(TexSym{"delta", "δ"});
	r.push(TexSym{"epsilon", "ε"});
	r.push(TexSym{"varepsilon", "ε"});
	r.push(TexSym{"zeta", "ζ"});
	r.push(TexSym{"eta", "η"});
	r.push(TexSym{"theta", "θ"});
	r.push(TexSym{"vartheta", "ϑ"});
	r.push(TexSym{"iota", "ι"});
	r.push(TexSym{"kappa", "κ"});
	r.push(TexSym{"lambda", "λ"});
	r.push(TexSym{"mu", "μ"});
	r.push(TexSym{"nu", "ν"});
	r.push(TexSym{"xi", "ξ"});
	r.push(TexSym{"pi", "π"});
	r.push(TexSym{"rho", "ρ"});
	r.push(TexSym{"sigma", "σ"});
	r.push(TexSym{"tau", "τ"});
	r.push(TexSym{"upsilon", "υ"});
	r.push(TexSym{"phi", "φ"});
	r.push(TexSym{"varphi", "φ"});
	r.push(TexSym{"chi", "χ"});
	r.push(TexSym{"psi", "ψ"});
	r.push(TexSym{"omega", "ω"});
	r.push(TexSym{"Gamma", "Γ"});
	r.push(TexSym{"Delta", "Δ"});
	r.push(TexSym{"Theta", "Θ"});
	r.push(TexSym{"Lambda", "Λ"});
	r.push(TexSym{"Xi", "Ξ"});
	r.push(TexSym{"Pi", "Π"});
	r.push(TexSym{"Sigma", "Σ"});
	r.push(TexSym{"Phi", "Φ"});
	r.push(TexSym{"Psi", "Ψ"});
	r.push(TexSym{"Omega", "Ω"});
	r.push(TexSym{"sum", "∑"});
	r.push(TexSym{"prod", "∏"});
	r.push(TexSym{"int", "∫"});
	r.push(TexSym{"iint", "∬"});
	r.push(TexSym{"oint", "∮"});
	r.push(TexSym{"partial", "∂"});
	r.push(TexSym{"nabla", "∇"});
	r.push(TexSym{"infty", "∞"});
	r.push(TexSym{"le", "≤"});
	r.push(TexSym{"leq", "≤"});
	r.push(TexSym{"ge", "≥"});
	r.push(TexSym{"geq", "≥"});
	r.push(TexSym{"ll", "≪"});
	r.push(TexSym{"gg", "≫"});
	r.push(TexSym{"ne", "≠"});
	r.push(TexSym{"neq", "≠"});
	r.push(TexSym{"approx", "≈"});
