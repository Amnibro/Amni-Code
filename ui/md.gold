FB_1 := "<pre style=\"margin:0;font-size:11px\">"
KW_PY := "and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield None True False self"
KW_JS := "await async break case catch class const continue default delete do else export extends finally for function if import in instanceof let new of return static super switch this throw try typeof var void while yield null true false undefined"
KW_RS := "as async await break const continue crate dyn else enum extern fn for if impl in let loop match mod move mut pub ref return self static struct super trait type unsafe use where while true false"
KW_SH := "if then else elif fi for while do done case esac function return export local source echo cd exit"
KW_SQL := "select from where insert update delete join left right inner outer group by order having limit values set into create table drop alter"
