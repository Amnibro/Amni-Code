TM_2 := "</div><div style=\"font-size:11px;color:var(--text2)\">"
NW_SRC := "<span class=\"src\">"
ST_1 := "<div class=\"row\"><span><strong>"
ST_2 := "</strong> "
ST_3 := "</span><span class=\"chg "
ST_4 := "%</span></div>"
